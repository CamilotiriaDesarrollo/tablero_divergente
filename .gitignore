# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.key
*.p12
*.pfx
credentials*.json
service-account*.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
/dev.log

# env files (can opt-in for committing if needed)
.env*
!.env.example

# supabase local
/supabase/.branches
/supabase/.temp
/supabase/.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# creador de imagenes: binarios de imagen no van al repo ni al deploy
# (OneDrive los respalda). Los textos (prompts, tablero) si se versionan.
/creador-imagenes/**/*.png
/creador-imagenes/**/*.jpg
/creador-imagenes/**/*.jpeg
/creador-imagenes/**/*.webp
/creador-imagenes/**/*.gif
/creador-imagenes/**/*.psd
/creador-imagenes/**/*.ai
/creador-imagenes/**/*.tif
/creador-imagenes/**/*.tiff
